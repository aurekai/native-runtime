#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# akai — Aurekai operator dispatcher (wraps Akai native binaries)
# Usage: akai <command> [args...]
set -euo pipefail

declare -A AKAI_OPS=(
  [api]=AkaiAPI [auth]=AkaiAuth [brief]=AkaiBrief
  [canon]=AkaiCanon [capability]=AkaiCapability [cli]=AkaiCLI
  [clips]=AkaiClips [cms]=AkaiCMS [compete]=AkaiCompete
  [compress]=AkaiCompress [control]=AkaiControl
  [detect-objects]=AkaiDetectObjects [discip]=AkaiDiscipl
  [distribute]=AkaiDistribute [economy]=AkaiEconomy
  [embed]=AkaiEmbed [emit]=AkaiEmit [entity]=AkaiEntity
  [family]=AkaiFamily [finance]=AkaiFinance
  [flash-qla]=AkaiFlashQLA [flow]=AkaiFlow
  [fpq]=AkaiFPQ [fpqx]=AkaiFPQx [fragment]=AkaiFragment
  [frame-extract]=AkaiFrameExtract [gate]=AkaiGate
  [gen]=AkaiGen [graph]=AkaiGraph [hash]=AkaiHash
  [index]=AkaiIndex [ingest]=AkaiIngest [kv-cache]=AkaiKVCache
  [layer]=AkaiLayer [leapfrog]=AkaiLeapfrog [learn]=AkaiLearn
  [ledger]=AkaiLedger [media-prep]=AkaiMediaPrep [meter]=AkaiMeter
  [mfa-dict]=AkaiMFADict [model]=AkaiModel [moq]=AkaiMoQ
  [narrate]=AkaiNarrate [net]=AkaiNet [offer]=AkaiOffer
  [orchestrate]=AkaiOrchestrate [outreach]=AkaiOutreach [pack]=AkaiPack
  [paragraph]=AkaiParagraph [pay]=AkaiPay [physics]=AkaiPhysics
  [pipeline]=AkaiPipeline [project]=AkaiProject [proof]=AkaiProof
  [proxy]=AkaiProxy [quant]=AkaiQuant [query]=AkaiQuery
  [queue]=AkaiQueue [reason]=AkaiReason [recipe]=AkaiRecipe
  [render]=AkaiRender [repurpose]=AkaiRepurpose [run]=AkaiRun
  [runtime]=AkaiRuntime [sae]=AkaiSAE [scene-detect]=AkaiSceneDetect
  [segment]=AkaiSegment [sli]=AkaiSLI [space]=AkaiSpace
  [speech-loop]=AkaiSpeechLoop [stitch]=AkaiStitch [surface]=AkaiSurface
  [swarm]=AkaiSwarm [sync]=AkaiSync [tag]=AkaiTag
  [tel]=AkaiTel [tier]=AkaiTier [time]=AkaiTime [tone]=AkaiTone
  [transcribe]=AkaiTranscribe [transcript-clean]=AkaiTranscriptClean
  [transcript-family]=AkaiTranscriptFamily [vec]=AkaiVec
  [video-demux]=AkaiVideoDemux [violence]=AkaiViolence
  [watch]=AkaiWatch [weaviate-index]=AkaiWeaviateIndex
  [wire]=AkaiWire [workflow]=AkaiWorkflow
)

CMD="${1:-}"

if [[ -z "$CMD" || "$CMD" == "--help" || "$CMD" == "-h" ]]; then
  echo "akai — Aurekai operator dispatcher"
  echo ""
  echo "Usage: akai <command> [args...]"
  echo ""
  echo "Available commands:"
  for k in $(echo "${!AKAI_OPS[@]}" | tr ' ' '\n' | sort); do
    printf "  %-22s %s\n" "$k" "${AKAI_OPS[$k]}"
  done
  exit 0
fi

if [[ -z "${AKAI_OPS[$CMD]+x}" ]]; then
  echo "akai: unknown command '$CMD'" >&2
  echo "Run 'akai --help' for the command list." >&2
  exit 1
fi

BINARY="${AKAI_OPS[$CMD]}"
AKAI_BIN_DIR="${AKAI_BIN_DIR:-$(dirname "$(realpath "$0")")/..}"

# Search order: AKAI_BIN_DIR/cmd/<Binary>/bin, $PATH, then try bonfyre alias
for search in \
  "$AKAI_BIN_DIR/cmd/$BINARY/bin/$BINARY" \
  "$(command -v "$BINARY" 2>/dev/null || true)"; do
  if [[ -x "$search" ]]; then
    exec "$search" "${@:2}"
  fi
done

echo "akai: '$BINARY' not found in build tree or PATH" >&2
echo "Run 'make' in the repo root to build operators." >&2
exit 127
